[Unit]
Description=HP Photosmart C4380 eSCL/AirScan bridge
Documentation=file:///opt/kerchunk/docs/scanning-findings.md
After=network-online.target avahi-daemon.service
Wants=network-online.target
Requires=avahi-daemon.service

[Service]
Type=simple
ExecStart=/opt/kerchunk/bin/escl-server.py
Restart=on-failure
RestartSec=10

# The bridge only needs to talk to the printer and listen on its own port.
User=kerchunk
Group=kerchunk
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/kerchunk/var
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
